<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Privacy Facts</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #1a1a1a;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      font-family: 'Arial Black', Arial, sans-serif;
      color: #ffffff;
    }

    .privacy-card {
      background: #111111;
      border: 3px solid #333333;
      border-radius: 4px;
      width: 380px;
      overflow: hidden;
    }

    /* ── Header ── */
    .privacy-header {
      padding: 20px 20px 0;
    }

    .privacy-header h1 {
      font-size: 2.6rem;
      font-weight: 900;
      letter-spacing: -1px;
      line-height: 1;
      margin-bottom: 12px;
    }

    .divider-thick {
      height: 8px;
      background: #ffffff;
      margin: 0 0 12px;
    }

    .divider-thin {
      height: 1px;
      background: #444444;
      margin: 0 0 16px;
    }

    /* ── Rating block ── */
    .rating-block {
      padding: 0 20px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      margin-bottom: 4px;
    }

    .rating-block .label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #cccccc;
      margin-bottom: 4px;
    }

    .rating-score {
      display: flex;
      align-items: baseline;
      gap: 6px;
    }

    .rating-score .score {
      font-size: 3.5rem;
      font-weight: 900;
      line-height: 1;
    }

    .rating-score .out-of {
      font-size: 1.3rem;
      font-weight: 700;
      color: #aaaaaa;
    }

    .grade-letter {
      font-size: 4.5rem;
      font-weight: 900;
      color: #e8614a;
      line-height: 1;
    }

    .rating-wrapper {
      padding: 0 20px 16px;
    }

    /* ── Rows ── */
    .rows {
      padding: 0 20px;
    }

    .row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 0 14px;
      border-bottom: 1px solid #333333;
    }

    .row:last-child {
      border-bottom: none;
    }

    .row-label {
      font-size: 1rem;
      font-weight: 700;
      color: #ffffff;
    }

    .row-status {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      font-weight: 900;
      letter-spacing: 0.5px;
    }

    .row-status.critical {
      color: #e8614a;
    }

    .row-status.disabled {
      color: #e8614a;
    }

    .row-status.good {
      color: #4caf50;
    }

    .row-status .icon {
      font-size: 0.85rem;
    }

    /* ── Footer note ── */
    .footnote {
      padding: 12px 20px 16px;
      font-size: 0.7rem;
      color: #888888;
      font-weight: 400;
      font-family: Arial, sans-serif;
      border-top: 1px solid #333333;
      margin-top: 4px;
    }

    /* ── Bottom bar ── */
    .bottom-bar {
      background: #111111;
      border-top: 1px solid #333333;
      width: 380px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 20px 8px;
      margin-top: 0;
    }

    .bottom-bar .bar-group {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .bottom-bar .bar-group:last-child {
      align-items: flex-end;
    }

    .bottom-bar .bar-label {
      font-size: 0.85rem;
      font-weight: 700;
      color: #cccccc;
    }

    .bottom-bar .bar-value {
      font-size: 1rem;
      font-weight: 900;
      color: #ffffff;
    }
  </style>
</head>
<body>

  <div class="privacy-card">
    <div class="privacy-header">
      <h1>Privacy Facts</h1>
      <div class="divider-thick"></div>
    </div>

    <div class="rating-wrapper">
      <div class="rating-block">
        <div>
          <div class="label">Overall Privacy Rating</div>
          <div class="rating-score">
            <span class="score">0</span>
            <span class="out-of">/ 10</span>
          </div>
        </div>
        <div class="grade-letter">F</div>
      </div>
    </div>

    <div class="divider-thick" style="margin: 0 20px 0; width: calc(100% - 40px);"></div>

    <div class="rows" style="margin-top: 8px;">
      <div class="row">
        <span class="row-label">Data Monetization</span>
        <span class="row-status critical">
          <span class="icon">✖</span> CRITICAL
        </span>
      </div>
      <div class="row">
        <span class="row-label">Precision Tracking</span>
        <span class="row-status critical">
          <span class="icon">✖</span> CRITICAL
        </span>
      </div>
      <div class="row">
        <span class="row-label">Account Autonomy</span>
        <span class="row-status disabled">
          <span class="icon">✖</span> DISABLED
        </span>
      </div>
      <div class="row">
        <span class="row-label">Legal Restrictions</span>
        <span class="row-status critical">
          <span class="icon">✖</span> CRITICAL
        </span>
      </div>
    </div>

    <div class="footnote">
      * Percent Daily Values are based on 100% data control
    </div>
  </div>

  <div class="bottom-bar">
    <div class="bar-group">
  
