{
  "manifest_version": 3,
  "name": "Privacy Facts",
  "version": "1.0.0",
  "description": "Instantly analyze the privacy policy and terms of any website you visit.",
  "permissions": ["tabs", "activeTab", "storage"],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://*.vercel.app/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Privacy Facts",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
